# Server Port (Render sets this automatically)
PORT=5000

# Cloud MongoDB Database (Required for public deployment, e.g. MongoDB Atlas)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/smartcare?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.mongodb.net/smartcare?retryWrites=true&w=majority

# JWT Secret Key (Any secure random string)
JWT_SECRET=smartcare_super_secret_jwt_key_2026

# JWT Expiration
JWT_EXPIRE=7d

# Environment
NODE_ENV=production

